# Copy to .env, or let ./local.sh up write it. Never commit .env.

# Airbyte API. local.sh fills these from `abctl local credentials`.
AIRBYTE_URL=http://localhost:8000
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
# Optional; defaults to the first workspace.
AIRBYTE_WORKSPACE_ID=

# S3 bucket every connection writes JSONL to, under <path>/<source>/<stream>/.
# The bucket must already exist. Omit the keys to use the instance role.
OPENCRAWL_LANDING_S3_BUCKET=
OPENCRAWL_LANDING_S3_PATH=opencrawl
OPENCRAWL_LANDING_S3_REGION=us-east-1
OPENCRAWL_LANDING_S3_ACCESS_KEY_ID=
OPENCRAWL_LANDING_S3_SECRET_ACCESS_KEY=

# OAuth sources need your own OAuth app on self-managed Airbyte.
# Register AIRBYTE_OAUTH_REDIRECT_URL as the app's redirect URL.
AIRBYTE_OAUTH_REDIRECT_URL=http://127.0.0.1:8765/callback
# AIRBYTE_OAUTH_<SOURCE_TYPE>_CLIENT_ID / _CLIENT_SECRET, source type upper-cased with _:
# AIRBYTE_OAUTH_GOOGLE_DRIVE_CLIENT_ID=
# AIRBYTE_OAUTH_GOOGLE_DRIVE_CLIENT_SECRET=
# AIRBYTE_OAUTH_NOTION_CLIENT_ID=
# AIRBYTE_OAUTH_NOTION_CLIENT_SECRET=
