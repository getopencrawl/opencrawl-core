# Copy to .env and set the S3 bucket below. Never commit .env.

# Where agent sessions land: your S3 bucket. These are the same settings the Airbyte
# landing destination uses (integrations/airbyte/.env.example); sessions go under
# <OPENCRAWL_LANDING_S3_PATH>/agent-sessions/.
OPENCRAWL_LANDING_S3_BUCKET=
OPENCRAWL_LANDING_S3_PATH=opencrawl
OPENCRAWL_LANDING_S3_REGION=us-east-1
# Omit the keys to use the AWS role where the receiver runs (EC2, ECS, EKS IRSA or Pod Identity).
OPENCRAWL_LANDING_S3_ACCESS_KEY_ID=
OPENCRAWL_LANDING_S3_SECRET_ACCESS_KEY=
# Only for temporary credentials.
# OPENCRAWL_LANDING_S3_SESSION_TOKEN=
# Only for S3-compatible stores other than AWS, e.g. https://<account>.r2.cloudflarestorage.com
# OPENCRAWL_LANDING_S3_ENDPOINT=

# Receiver. Collectors send transcripts to http://127.0.0.1:OPENCRAWL_SESSIONS_PORT.
OPENCRAWL_SESSIONS_PORT=7171
# Require this bearer token from collectors and MCP clients. Set it whenever the
# receiver is reachable beyond loopback.
OPENCRAWL_SESSIONS_TOKEN=
# URL the install script points collectors at, if not the one it was fetched from.
# OPENCRAWL_SESSIONS_PUBLIC_URL=https://sessions.example.com

# ./local.sh up --bundled-s3 sets these to run a local S3 (SeaweedFS) for development.
# COMPOSE_PROFILES=bundled-s3
# OPENCRAWL_BUNDLED_S3_PORT=8333
# OPENCRAWL_BUNDLED_S3_CONSOLE_PORT=12535
