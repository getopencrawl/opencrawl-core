{
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" workload",
          "timeout": 120
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" privacy",
          "timeout": 7
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" capture",
          "timeout": 5
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" suggest",
          "timeout": 3
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" inbox",
          "timeout": 4
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" capture",
          "timeout": 5
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" suggest",
          "timeout": 3
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" inbox",
          "timeout": 4
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" capture",
          "timeout": 5
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" inbox",
          "timeout": 4
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" capture",
          "timeout": 5
        }
      ]
    }
  ]
}
