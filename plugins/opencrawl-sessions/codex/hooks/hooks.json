{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" session start --harness codex",
            "timeout": 7,
            "statusMessage": "OpenCrawl session startup"
          },
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" collect hook --harness codex",
            "timeout": 120,
            "async": true,
            "statusMessage": "OpenCrawl session capture"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" collect hook --harness codex",
            "timeout": 120,
            "async": true,
            "statusMessage": "OpenCrawl session capture"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" collect hook --harness codex",
            "timeout": 120,
            "async": true,
            "statusMessage": "OpenCrawl session capture"
          }
        ]
      },
      {
        "matcher": "^mcp__opencrawl__opencrawl_search(?:_v1)?$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" search-context --harness codex",
            "timeout": 2,
            "statusMessage": "OpenCrawl search context"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" collect hook --harness codex",
            "timeout": 120,
            "async": true,
            "statusMessage": "OpenCrawl session capture"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" collect hook --harness codex",
            "timeout": 120,
            "async": true,
            "statusMessage": "OpenCrawl session capture"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" collect hook --harness codex",
            "timeout": 120,
            "async": true,
            "statusMessage": "OpenCrawl session capture"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"$PLUGIN_ROOT/scripts/opencrawl-hook.sh\" collect hook --harness codex",
            "timeout": 3,
            "statusMessage": "OpenCrawl session capture"
          }
        ]
      }
    ]
  }
}
