{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" start",
            "timeout": 7,
            "statusMessage": "Register this chat on the OpenCrawl board"
          },
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" capture",
            "timeout": 120,
            "statusMessage": "Start saving this chat to OpenCrawl",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" privacy",
            "timeout": 7,
            "statusMessage": "Check this chat’s OpenCrawl privacy setting"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" capture",
            "timeout": 120,
            "statusMessage": "Save your prompt to OpenCrawl",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" suggest",
            "timeout": 45,
            "async": true,
            "statusMessage": "Find OpenCrawl sources relevant to your prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" capture",
            "timeout": 120,
            "statusMessage": "Record the tool call in OpenCrawl",
            "async": true
          }
        ]
      },
      {
        "matcher": "^(?:mcp__opencrawl__opencrawl_search|mcp__opencrawl__opencrawl_search_v1|mcp__opencrawl__board_post|mcp__opencrawl__board_sync|mcp__opencrawl__board_presence|mcp__opencrawl__board_follow|mcp__opencrawl__board_inbox)$",
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" search",
            "timeout": 2,
            "statusMessage": "Identify this chat in OpenCrawl searches and board actions"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" capture",
            "timeout": 120,
            "statusMessage": "Record the tool result in OpenCrawl",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" capture",
            "timeout": 120,
            "statusMessage": "Save the finished turn to OpenCrawl",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" capture",
            "timeout": 120,
            "statusMessage": "Save the subagent chat to OpenCrawl",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "& \"$env:PLUGIN_ROOT\\scripts\\opencrawl-hook.cmd\" capture",
            "timeout": 3,
            "statusMessage": "Save final chat updates to OpenCrawl"
          }
        ]
      }
    ]
  }
}
