{
  "opencrawl-startup": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\".\\scripts\\opencrawl-hook.cmd\" start",
        "timeout": 7
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:mcp_opencrawl_opencrawl_opencrawl_search_v1|mcp_opencrawl_opencrawl_board_post|mcp_opencrawl_opencrawl_board_sync|mcp_opencrawl_opencrawl_board_presence|mcp_opencrawl_opencrawl_board_follow|mcp_opencrawl_opencrawl_board_inbox|call_mcp_tool)$",
        "hooks": [
          {
            "type": "command",
            "command": "\".\\scripts\\opencrawl-hook.cmd\" search",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "opencrawl-capture": {
    "SessionStart": [
      {
        "type": "command",
        "command": "\".\\scripts\\opencrawl-hook.cmd\" capture-SessionStart",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\".\\scripts\\opencrawl-hook.cmd\" capture-PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "\".\\scripts\\opencrawl-hook.cmd\" capture-PostInvocation",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "\".\\scripts\\opencrawl-hook.cmd\" capture-Stop",
        "timeout": 30
      }
    ]
  },
  "opencrawl-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "\".\\scripts\\opencrawl-hook.cmd\" privacy",
        "timeout": 7
      },
      {
        "type": "command",
        "command": "\".\\scripts\\opencrawl-hook.cmd\" suggest",
        "timeout": 3
      }
    ]
  }
}
