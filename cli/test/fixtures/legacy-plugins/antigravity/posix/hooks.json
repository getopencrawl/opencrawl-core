{
  "opencrawl-startup": {
    "SessionStart": [
      {
        "type": "command",
        "command": "/bin/sh ./scripts/opencrawl-hook.sh start",
        "timeout": 7
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(?:mcp_opencrawl_opencrawl_opencrawl_search_v1|mcp_opencrawl_opencrawl_board_post|mcp_opencrawl_opencrawl_board_sync|mcp_opencrawl_opencrawl_board_presence|mcp_opencrawl_opencrawl_board_follow|mcp_opencrawl_opencrawl_board_inbox|call_mcp_tool)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh ./scripts/opencrawl-hook.sh search",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "opencrawl-capture": {
    "SessionStart": [
      {
        "type": "command",
        "command": "/bin/sh ./scripts/opencrawl-hook.sh capture-SessionStart",
        "timeout": 30
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh ./scripts/opencrawl-hook.sh capture-PostToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "/bin/sh ./scripts/opencrawl-hook.sh capture-PostInvocation",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/bin/sh ./scripts/opencrawl-hook.sh capture-Stop",
        "timeout": 30
      }
    ]
  },
  "opencrawl-context": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "/bin/sh ./scripts/opencrawl-hook.sh privacy",
        "timeout": 7
      },
      {
        "type": "command",
        "command": "/bin/sh ./scripts/opencrawl-hook.sh suggest",
        "timeout": 3
      }
    ]
  }
}
