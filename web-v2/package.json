{
  "name": "@getopencrawl/web-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared TypeScript React operations console and design system.",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node --import tsx tools/build.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser": "playwright test --config test/onboarding.playwright.ts",
    "start": "node --import tsx tools/reference-server.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "react-router": "8.5.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "@trpc/client": "11.25.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
