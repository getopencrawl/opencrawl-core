#!/usr/bin/env bash
set -euo pipefail
umask 077
ROOT="$(cd -- "$(dirname -- "$0")/.." && pwd -P)"
for arg in "$@"; do
if [[ "$arg" == --help || "$arg" == -h ]]; then
  cat <<'HELP'
Usage: ./dev/up [up|demo] [--no-airbyte] [--sqlite]
       ./dev/up [status|stop|reset --yes]

Development only. Linux or macOS, x64 or ARM64.
Full stack: 4 CPUs, 16 GiB RAM, 40 GiB free disk.
With --no-airbyte: 4 CPUs, 8 GiB RAM, 20 GiB free disk; Docker Compose only.
On macOS, install and start Docker Desktop or Colima first.
On Ubuntu 24.04, the first run installs Docker if absent (using sudo). It downloads pinned tools,
starts a private Airbyte kind cluster and the normal OpenCrawl Compose stack,
generates a local login, and leaves first-run onboarding ready for you.
Use ./dev/up demo to load synthetic data and automatically complete onboarding.
Use ./dev/up --no-airbyte for capture, memories, search and board without external
sources. Repeat the flag on every up/demo invocation; omit it to enable Airbyte.
Existing Airbyte data is retained when disabling it.
Use --sqlite on the first run to use SQLite FTS5 instead of OpenSearch.
The search backend is saved for future starts, status, stop and reset.
Existing OpenSearch installations require an explicit index migration.
No service credentials or .env editing. Internet is needed to download images.

OPENCRAWL_DEV_PORT=8092 and OPENCRAWL_DEV_AIRBYTE_PORT=8000 select loopback ports
on first run. OPENCRAWL_DEV_ORIGIN optionally selects an HTTPS reverse proxy URL.
Reruns preserve accounts and data. stop preserves volumes. reset --yes destroys
only this clone's development installation. Production deploy/ is independent.
HELP
  exit 0
fi
case "$arg" in up|demo|status|stop|reset|--yes|--no-airbyte|--sqlite|--node-runtime) ;; *) echo "Unknown argument: $arg. See ./dev/up --help." >&2; exit 1 ;; esac
done
# Shared, internal runtime bootstrap for operator upgrade tools. Keep all normal
# startup modes on the same full application; this mode launches no services.
NODE_ONLY=false
if [[ "${1:-}" == --node-runtime ]]; then
  [[ $# == 1 ]] || { echo 'The runtime bootstrap takes no other arguments.' >&2; exit 1; }
  NODE_ONLY=true
  exec 3>&1
  exec 1>&2
fi
MIN_DISK_KIB=41943040
for arg in "$@"; do [[ "$arg" != --no-airbyte ]] || MIN_DISK_KIB=20971520; done
case "$(uname -s)" in
  Linux) NODE_OS=linux; NODE_EXT=tar.xz ;;
  Darwin) NODE_OS=darwin; NODE_EXT=tar.gz ;;
  *) echo 'This installer supports Linux and macOS on x64 or ARM64.' >&2; exit 1 ;;
esac
case "$(uname -m)" in
  x86_64|amd64) NODE_ARCH=x64 ;;
  arm64|aarch64) NODE_ARCH=arm64 ;;
  *) echo 'This installer supports x64 and ARM64 processors.' >&2; exit 1 ;;
esac
if [[ "$NODE_ONLY" != true ]]; then
if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
  if [[ "$NODE_OS" == darwin ]]; then
    echo 'Install and start Docker Desktop or Colima, then retry. Allocate at least 4 CPUs and 8 GiB RAM (16 GiB with Airbyte).' >&2
    exit 1
  fi
  if [[ $EUID -ne 0 ]]; then
    echo 'Docker installation/access needs administrator privileges; requesting sudo.'
    exec sudo -- env "OPENCRAWL_DEV_PORT=${OPENCRAWL_DEV_PORT:-8092}" \
      "OPENCRAWL_DEV_AIRBYTE_PORT=${OPENCRAWL_DEV_AIRBYTE_PORT:-8000}" \
      "OPENCRAWL_DEV_ORIGIN=${OPENCRAWL_DEV_ORIGIN:-}" bash "$ROOT/dev/up" "$@"
  fi
  if ! command -v docker >/dev/null 2>&1; then
    # Use the OS package signature chain; never pipe a downloaded script to root.
    source /etc/os-release
    [[ "$ID" == ubuntu && "$VERSION_ID" == 24.04 ]] || {
      echo 'Automatic Docker installation supports Ubuntu 24.04. Install Docker and Compose first on other Linux distributions.' >&2; exit 1;
    }
    [[ $(df -Pk "$ROOT" | awk 'NR==2 {print $4}') -ge "$MIN_DISK_KIB" ]] || { echo "At least $((MIN_DISK_KIB / 1048576)) GiB free disk is required." >&2; exit 1; }
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y docker.io docker-compose-v2 curl ca-certificates xz-utils
    systemctl enable --now docker
  else
    echo 'Docker is installed but unavailable. Start its daemon and retry.' >&2; exit 1
  fi
fi
docker compose version >/dev/null || { echo 'Install the Docker Compose v2 plugin, then retry.' >&2; exit 1; }
fi
STATE="$ROOT/.opencrawl-dev"
if [[ "$NODE_ONLY" == true && ! -x "$STATE/bin/node" ]]; then STATE="$ROOT/deploy/.upgrade"; fi
[[ ! -L "$STATE" ]] || { echo 'Refusing a symlinked development state directory.' >&2; exit 1; }
mkdir -p "$STATE/bin"
chmod 700 "$STATE"
NODE="$STATE/bin/node"
NODE_VERSION=24.22.2
NODE_DIST="node-v$NODE_VERSION-$NODE_OS-$NODE_ARCH"
if [[ ! -x "$NODE" ]]; then
  ARCHIVE="$NODE_DIST.$NODE_EXT"
  EXPECTED=$(awk -v name="$ARCHIVE" '$2 == name {print $1}' "$ROOT/dev/node-checksums.txt")
  [[ "$EXPECTED" =~ ^[a-f0-9]{64}$ ]] || { echo "No pinned checksum for $ARCHIVE" >&2; exit 1; }
  DOWNLOAD=$(mktemp -d "$STATE/node-install.XXXXXX")
  trap 'rm -rf -- "$DOWNLOAD"' EXIT
  echo "Downloading the pinned Node.js runtime for $NODE_OS $NODE_ARCH."
  curl --fail --silent --show-error --location --retry 3 \
    "https://nodejs.org/dist/v$NODE_VERSION/$ARCHIVE" -o "$DOWNLOAD/$ARCHIVE"
  if command -v sha256sum >/dev/null 2>&1; then
    ACTUAL=$(sha256sum "$DOWNLOAD/$ARCHIVE" | awk '{print $1}')
  else
    ACTUAL=$(shasum -a 256 "$DOWNLOAD/$ARCHIVE" | awk '{print $1}')
  fi
  [[ "$ACTUAL" == "$EXPECTED" ]] || { echo 'Node.js download checksum mismatch; existing data is preserved.' >&2; exit 1; }
  tar -xf "$DOWNLOAD/$ARCHIVE" -C "$DOWNLOAD" "$NODE_DIST/bin/node"
  mv "$DOWNLOAD/$NODE_DIST/bin/node" "$NODE"
  rm -rf -- "$DOWNLOAD"
  trap - EXIT
fi
if [[ "$("$NODE" -p 'process.version+"-"+process.platform+"-"+process.arch' 2>/dev/null)" != "v$NODE_VERSION-$NODE_OS-$NODE_ARCH" ]]; then
  echo 'Cached Node.js runtime does not match this host/version. Remove only .opencrawl-dev/bin/node and retry; keep the rest of your data.' >&2
  exit 1
fi
if [[ "$NODE_ONLY" == true ]]; then printf '%s\n' "$NODE" >&3; exit 0; fi
exec "$NODE" --disable-warning=ExperimentalWarning "$ROOT/dev/installer.mts" "$@"
