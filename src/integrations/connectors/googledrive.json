{
  "version": "7.28.2",
  "type": "DeclarativeSource",
  "description": "Google Drive shared drives only (never My Drive or files merely shared with the user): shared drives, file metadata, and Google Docs, Sheets and Slides exported as text, through the credential proxy proxy. Requires the configured operator credential proxy.",
  "check": {
    "type": "CheckStream",
    "stream_names": [
      "drives"
    ]
  },
  "concurrency_level": {
    "type": "ConcurrencyLevel",
    "default_concurrency": "{{ config.get('num_workers', 3) }}",
    "max_concurrency": 10
  },
  "api_budget": {
    "type": "HTTPAPIBudget",
    "policies": [
      {
        "type": "MovingWindowCallRatePolicy",
        "rates": [
          {
            "limit": "{{ config.get('requests_per_minute', 600) }}",
            "interval": "PT1M"
          }
        ],
        "matchers": [
          {
            "method": "POST",
            "url_path_pattern": "/api/connector-proxy"
          }
        ]
      }
    ]
  },
  "definitions": {
    "credential_proxy_requester": {
      "type": "HttpRequester",
      "url_base": "{{ config.get('credential_proxy_base_url', 'https://credential-proxy.invalid') }}",
      "path": "/api/connector-proxy",
      "http_method": "POST",
      "authenticator": {
        "type": "ApiKeyAuthenticator",
        "api_token": "{{ config['credential_proxy_api_key'] }}",
        "inject_into": {
          "type": "RequestOption",
          "inject_into": "header",
          "field_name": "x-api-key"
        }
      },
      "error_handler": {
        "type": "CompositeErrorHandler",
        "error_handlers": [
          {
            "type": "DefaultErrorHandler",
            "max_retries": 10,
            "backoff_strategies": [
              {
                "type": "WaitTimeFromResponse",
                "wait_time_in_seconds": "{{ ((response.get('headers') or {}).get('retry-after') or (response.get('headers') or {}).get('Retry-After') or 0) | int + 1 }}",
                "max_waiting_time_in_seconds": 600
              },
              {
                "type": "ExponentialBackoffStrategy",
                "factor": 5
              }
            ],
            "response_filters": [
              {
                "type": "HttpResponseFilter",
                "action": "RETRY",
                "predicate": "{{ response.get('status') in [429, 500, 502, 503, 504] or (response.get('status') == 403 and (((response.get('data') or {}).get('error') or {}).get('errors') or [{}])[0].get('reason') in ['rateLimitExceeded', 'userRateLimitExceeded']) }}",
                "error_message": "Google Drive is rate limiting or unavailable; retrying."
              },
              {
                "type": "HttpResponseFilter",
                "action": "FAIL",
                "failure_type": "config_error",
                "predicate": "{{ response.get('status') == 401 }}",
                "error_message": "Google Drive rejected the connection. Reconnect Google Drive."
              },
              {
                "type": "HttpResponseFilter",
                "action": "FAIL",
                "failure_type": "system_error",
                "predicate": "{{ (response.get('status') or 0) >= 400 }}",
                "error_message": "Google Drive returned an unexpected error through the credential proxy proxy."
              }
            ]
          }
        ]
      }
    },
    "drives": {
      "type": "DeclarativeStream",
      "name": "drives",
      "primary_key": [
        "id"
      ],
      "schema_loader": {
        "type": "InlineSchemaLoader",
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": [
                "null",
                "string"
              ]
            },
            "createdTime": {
              "type": [
                "null",
                "string"
              ]
            },
            "hidden": {
              "type": [
                "null",
                "boolean"
              ]
            },
            "restrictions": {
              "type": [
                "null",
                "object"
              ],
              "additionalProperties": true
            },
            "capabilities": {
              "type": [
                "null",
                "object"
              ],
              "additionalProperties": true
            }
          }
        }
      },
      "retriever": {
        "type": "SimpleRetriever",
        "requester": {
          "$ref": "#/definitions/credential_proxy_requester",
          "request_body": {
            "type": "RequestBodyJsonObject",
            "value": {
              "connected_account_id": "{{ config['connected_account_id'] }}",
              "user_id": "{{ config['user_id'] }}",
              "method": "GET",
              "endpoint": "https://www.googleapis.com/drive/v3/drives",
              "parameters": "{{ [{'name': 'pageSize', 'value': '100', 'type': 'query'}, {'name': 'fields', 'value': 'nextPageToken,drives(id,name,createdTime,hidden,restrictions,capabilities(canDownload,canCopy))', 'type': 'query'}] + ([{'name': 'pageToken', 'value': next_page_token.next_page_token, 'type': 'query'}] if next_page_token else []) }}"
            }
          }
        },
        "record_selector": {
          "type": "RecordSelector",
          "extractor": {
            "type": "DpathExtractor",
            "field_path": [
              "data",
              "drives"
            ]
          }
        },
        "paginator": {
          "type": "DefaultPaginator",
          "pagination_strategy": {
            "type": "CursorPagination",
            "cursor_value": "{{ (response.get('data') or {}).get('nextPageToken') }}",
            "stop_condition": "{{ not (response.get('data') or {}).get('nextPageToken') }}"
          }
        }
      }
    },
