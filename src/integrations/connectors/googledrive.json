{
  "version": "7.28.2",
  "type": "DeclarativeSource",
  "description": "Google Drive documents with live workspace-wide permission checks through the operator credential proxy. Full snapshots refresh permission-only changes.",
  "check": {
    "type": "CheckStream",
    "stream_names": [
      "workspace_documents"
    ]
  },
  "streams": [
    {
      "type": "DeclarativeStream",
      "name": "workspace_documents",
      "primary_key": [
        "id"
      ],
      "schema_loader": {
        "type": "InlineSchemaLoader",
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "id",
            "name",
            "mimeType",
            "version",
            "modifiedTime",
            "text",
            "extractionStatus",
            "access"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "mimeType": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "modifiedTime": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "extractionStatus": {
              "type": "string"
            },
            "access": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "retriever": {
        "type": "SimpleRetriever",
        "requester": {
          "type": "HttpRequester",
          "url_base": "{{ config['credential_proxy_base_url'] }}",
          "path": "/api/connector-proxy",
          "http_method": "POST",
          "authenticator": {
            "type": "ApiKeyAuthenticator",
            "api_token": "{{ config['credential_proxy_api_key'] }}",
            "inject_into": {
              "type": "RequestOption",
              "inject_into": "header",
              "field_name": "x-api-key"
            }
          },
          "request_body": {
            "type": "RequestBodyJsonObject",
            "value": {
              "connected_account_id": "{{ config['connected_account_id'] }}",
              "user_id": "{{ config['user_id'] }}",
              "method": "GET",
              "endpoint": "opencrawl://googledrive/workspace-documents",
              "parameters": "{{ [{'name': 'pageToken', 'value': next_page_token.next_page_token, 'type': 'query'}] if next_page_token else [] }}"
            }
          },
          "error_handler": {
            "type": "DefaultErrorHandler",
            "max_retries": 5,
            "backoff_strategies": [
              {
                "type": "ExponentialBackoffStrategy",
                "factor": 5
              }
            ]
          }
        },
        "record_selector": {
          "type": "RecordSelector",
          "extractor": {
            "type": "DpathExtractor",
            "field_path": [
              "data",
              "documents"
            ]
          }
        },
        "paginator": {
          "type": "DefaultPaginator",
          "pagination_strategy": {
            "type": "CursorPagination",
            "cursor_value": "{{ (response.get('data') or {}).get('nextPageToken') }}",
            "stop_condition": "{{ not (response.get('data') or {}).get('nextPageToken') }}"
          }
        }
      }
    }
  ],
  "spec": {
    "type": "Spec",
    "connection_specification": {
      "type": "object",
      "required": [
        "credential_proxy_base_url",
        "credential_proxy_api_key",
        "connected_account_id",
        "user_id"
      ],
      "properties": {
        "credential_proxy_base_url": {
          "type": "string",
          "title": "Operator credential proxy URL"
        },
        "credential_proxy_api_key": {
          "type": "string",
          "airbyte_secret": true
        },
        "connected_account_id": {
          "type": "string"
        },
        "user_id": {
          "type": "string"
        }
      }
    }
  }
}
