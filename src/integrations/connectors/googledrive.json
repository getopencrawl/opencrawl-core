        "requester": {
          "$ref": "#/definitions/credential_proxy_requester",
          "request_body": {
            "type": "RequestBodyJsonObject",
            "value": {
              "connected_account_id": "{{ config['connected_account_id'] }}",
              "user_id": "{{ config['user_id'] }}",
              "method": "GET",
              "endpoint": "https://www.googleapis.com/drive/v3/files",
              "parameters": "{{ [{'name': 'corpora', 'value': 'drive', 'type': 'query'}, {'name': 'driveId', 'value': stream_partition.drive_id, 'type': 'query'}, {'name': 'includeItemsFromAllDrives', 'value': 'true', 'type': 'query'}, {'name': 'supportsAllDrives', 'value': 'true', 'type': 'query'}, {'name': 'pageSize', 'value': '1000', 'type': 'query'}, {'name': 'orderBy', 'value': 'modifiedTime', 'type': 'query'}, {'name': 'q', 'value': 'trashed = false and (mimeType = \\'application/vnd.google-apps.document\\' or mimeType = \\'application/vnd.google-apps.spreadsheet\\' or mimeType = \\'application/vnd.google-apps.presentation\\') and modifiedTime > \\'' ~ stream_interval.start_time ~ '\\'', 'type': 'query'}, {'name': 'fields', 'value': 'nextPageToken,incompleteSearch,files(id,name,mimeType,driveId,parents,createdTime,modifiedTime,trashed,webViewLink,size,md5Checksum,fileExtension,description,starred,version,headRevisionId,lastModifyingUser(displayName,emailAddress),owners(displayName,emailAddress))', 'type': 'query'}] + ([{'name': 'pageToken', 'value': next_page_token.next_page_token, 'type': 'query'}] if next_page_token else []) }}"
            }
          }
        },
        "record_selector": {
          "type": "RecordSelector",
          "extractor": {
            "type": "DpathExtractor",
            "field_path": [
              "data",
              "files"
            ]
          },
          "record_filter": {
            "type": "RecordFilter",
            "condition": "{{ record.get('driveId') == stream_partition.drive_id and not record.get('trashed') }}"
          }
        },
        "paginator": {
          "type": "DefaultPaginator",
          "pagination_strategy": {
            "type": "CursorPagination",
            "cursor_value": "{{ (response.get('data') or {}).get('nextPageToken') }}",
            "stop_condition": "{{ not (response.get('data') or {}).get('nextPageToken') }}"
          }
        },
        "partition_router": {
          "type": "SubstreamPartitionRouter",
          "parent_stream_configs": [
            {
              "type": "ParentStreamConfig",
              "stream": {
                "$ref": "#/definitions/drives"
              },
              "parent_key": "id",
              "partition_field": "drive_id",
