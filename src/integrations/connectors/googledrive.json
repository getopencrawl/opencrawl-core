            }
          ]
        },
        {
          "type": "RemoveFields",
          "field_pointers": [
            [
              "headers"
            ],
            [
              "successful"
            ],
            [
              "error"
            ]
          ]
        }
      ],
      "incremental_sync": {
        "type": "DatetimeBasedCursor",
        "cursor_field": "modifiedTime",
        "datetime_format": "%Y-%m-%dT%H:%M:%S.%fZ",
        "cursor_datetime_formats": [
          "%Y-%m-%dT%H:%M:%S.%fZ",
          "%Y-%m-%dT%H:%M:%SZ"
        ],
        "start_datetime": {
          "type": "MinMaxDatetime",
          "datetime": "{{ config.get('start_date', '2000-01-01T00:00:00Z') }}",
          "datetime_format": "%Y-%m-%dT%H:%M:%SZ"
        },
        "global_substream_cursor": true,
        "is_client_side_incremental": false
      }
    }
  ],
  "spec": {
    "type": "Spec",
    "connection_specification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Google Drive shared drives via credential proxy",
      "type": "object",
      "required": [
        "credential_proxy_api_key",
        "connected_account_id",
        "user_id",
        "start_date"
      ],
      "additionalProperties": true,
      "properties": {
        "credential_proxy_api_key": {
          "type": "string",
          "title": "credential proxy project API key",
          "airbyte_secret": true,
          "order": 0
        },
        "connected_account_id": {
          "type": "string",
          "title": "credential proxy connected account",
          "pattern": "^ca_[A-Za-z0-9_-]+$",
          "order": 1
        },
        "user_id": {
          "type": "string",
          "title": "credential proxy user ID",
          "order": 2
        },
        "start_date": {
          "type": "string",
          "title": "Start date",
          "description": "Files modified before this are skipped. Hosted OpenCrawl imports everything (2000-01-01).",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "order": 3
        },
        "credential_proxy_base_url": {
          "type": "string",
          "title": "credential proxy API base URL",
          "default": "https://credential-proxy.invalid",
          "order": 4
        },
        "requests_per_minute": {
          "type": "integer",
          "title": "Requests per minute",
          "default": 600,
          "minimum": 1,
          "maximum": 6000,
          "order": 5
        },
        "lookback": {
          "type": "string",
          "title": "Lookback (ISO 8601 duration)",
          "default": "PT30M",
          "order": 6
        },
        "num_workers": {
          "type": "integer",
          "title": "Concurrent requests",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "order": 7
        }
      }
    }
  }
}
