{
  "version": "7.28.2",
  "type": "DeclarativeSource",
  "description": "Notion pages, databases, page content (as Notion-flavoured markdown), comments and members through the credential proxy proxy. Requires the configured operator credential proxy.",
  "check": {
    "type": "CheckStream",
    "stream_names": [
      "users"
    ]
  },
  "concurrency_level": {
    "type": "ConcurrencyLevel",
    "default_concurrency": "{{ config.get('num_workers', 3) }}",
    "max_concurrency": 10
  },
  "api_budget": {
    "type": "HTTPAPIBudget",
    "policies": [
      {
        "type": "MovingWindowCallRatePolicy",
        "rates": [
          {
            "limit": "{{ config.get('requests_per_minute', 170) }}",
            "interval": "PT1M"
          }
        ],
        "matchers": [
          {
            "method": "POST",
            "url_path_pattern": "/api/connector-proxy"
          }
        ]
      }
    ]
  },
  "definitions": {
    "credential_proxy_requester": {
      "type": "HttpRequester",
      "url_base": "{{ config.get('credential_proxy_base_url', 'https://credential-proxy.invalid') }}",
      "path": "/api/connector-proxy",
      "http_method": "POST",
      "authenticator": {
        "type": "ApiKeyAuthenticator",
        "api_token": "{{ config['credential_proxy_api_key'] }}",
        "inject_into": {
          "type": "RequestOption",
          "inject_into": "header",
          "field_name": "x-api-key"
        }
      },
      "error_handler": {
        "type": "CompositeErrorHandler",
        "error_handlers": [
          {
            "type": "DefaultErrorHandler",
            "max_retries": 10,
            "backoff_strategies": [
              {
                "type": "WaitTimeFromResponse",
                "wait_time_in_seconds": "{{ ((response.get('headers') or {}).get('retry-after') or (response.get('headers') or {}).get('Retry-After') or ((response.get('data') or {}).get('additional_data') or {}).get('retry_after') or 0) | int + 1 }}",
                "max_waiting_time_in_seconds": 600
              },
              {
                "type": "ExponentialBackoffStrategy",
                "factor": 5
              }
            ],
            "response_filters": [
              {
                "type": "HttpResponseFilter",
                "action": "RETRY",
                "predicate": "{{ response.get('status') in [429, 529, 500, 502, 503, 504] and ((response.get('data') or {}).get('additional_data') or {}).get('rate_limit_reason') != 'public_api_request_blocked' }}",
                "error_message": "Notion is rate limiting or unavailable; retrying."
              },
              {
                "type": "HttpResponseFilter",
                "action": "FAIL",
                "failure_type": "config_error",
                "predicate": "{{ response.get('status') == 401 or (response.get('data') or {}).get('code') in ['unauthorized', 'restricted_resource'] and response.get('status') != 403 }}",
                "error_message": "Notion rejected the connection. Reconnect Notion."
              },
              {
                "type": "HttpResponseFilter",
                "action": "FAIL",
                "failure_type": "system_error",
                "predicate": "{{ (response.get('status') or 0) >= 400 }}",
                "error_message": "Notion returned an unexpected error through the credential proxy proxy."
              }
            ]
          }
        ]
      }
    },
    "pages": {
      "type": "DeclarativeStream",
      "name": "pages",
      "primary_key": [
        "id"
      ],
      "schema_loader": {
        "type": "InlineSchemaLoader",
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string"
            },
            "object": {
              "type": [
                "null",
                "string"
              ]
            },
            "created_time": {
              "type": [
                "null",
                "string"
              ]
            },
            "last_edited_time": {
              "type": "string"
            },
            "created_by": {
              "type": [
                "null",
                "object"
              ],
              "additionalProperties": true
            },
            "last_edited_by": {
              "type": [
                "null",
                "object"
              ],
              "additionalProperties": true
            },
            "parent": {
              "type": [
                "null",
                "object"
              ],
              "additionalProperties": true
            },
            "properties": {
              "type": [
                "null",
                "object"
              ],
              "additionalProperties": true
            },
            "url": {
              "type": [
                "null",
                "string"
              ]
            },
            "public_url": {
              "type": [
                "null",
                "string"
              ]
            },
            "in_trash": {
              "type": [
                "null",
                "boolean"
              ]
            },
            "is_archived": {
              "type": [
                "null",
                "boolean"
              ]
            },
            "icon": {
              "type": [
                "null",
                "object"
              ],
              "additionalProperties": true
            },
            "cover": {
              "type": [
                "null",
                "object"
              ],
              "additionalProperties": true
            }
          }
        }
      },
      "retriever": {
        "type": "SimpleRetriever",
        "requester": {
          "$ref": "#/definitions/credential_proxy_requester",
          "request_body": {
            "type": "RequestBodyJsonObject",
            "value": {
              "connected_account_id": "{{ config['connected_account_id'] }}",
              "user_id": "{{ config['user_id'] }}",
              "method": "POST",
              "endpoint": "https://api.notion.com/v1/search",
              "parameters": "{{ [{'name': 'Notion-Version', 'value': config.get('notion_version', '2026-03-11'), 'type': 'header'}] + [] }}",
              "body": {
                "filter": {
                  "property": "object",
                  "value": "page"
                },
                "sort": {
                  "timestamp": "last_edited_time",
                  "direction": "ascending"
                },
                "page_size": 100,
                "start_cursor": "{{ next_page_token.next_page_token if next_page_token else None }}"
              }
            }
          }
        },
        "record_selector": {
          "type": "RecordSelector",
          "extractor": {
            "type": "DpathExtractor",
            "field_path": [
              "data",
              "results"
            ]
          },
          "record_filter": {
            "type": "RecordFilter",
            "condition": "{{ record.get('object') == 'page' and ((record.get('last_edited_time') or '') >= (stream_interval.start_time if stream_interval and stream_interval.get('start_time') else '') or ((record.get('id') or '0')[-4:] | int(0, 16)) % 672 == (now_utc().weekday() * 96 + now_utc().hour * 4 + now_utc().minute // 15)) }}"
          }
        },
        "paginator": {
          "type": "DefaultPaginator",
          "pagination_strategy": {
            "type": "CursorPagination",
            "cursor_value": "{{ (response.get('data') or {}).get('next_cursor') }}",
            "stop_condition": "{{ not (response.get('data') or {}).get('has_more') or not (response.get('data') or {}).get('next_cursor') }}"
          }
        }
      },
      "incremental_sync": {
        "type": "DatetimeBasedCursor",
        "cursor_field": "last_edited_time",
        "datetime_format": "%Y-%m-%dT%H:%M:%S.%fZ",
        "cursor_datetime_formats": [
          "%Y-%m-%dT%H:%M:%S.%fZ",
          "%Y-%m-%dT%H:%M:%SZ"
        ],
        "start_datetime": {
          "type": "MinMaxDatetime",
          "datetime": "{{ config.get('start_date', '2000-01-01T00:00:00Z') }}",
          "datetime_format": "%Y-%m-%dT%H:%M:%SZ"
        },
        "lookback_window": "{{ config.get('lookback', 'PT30M') }}"
      }
    }
  },
