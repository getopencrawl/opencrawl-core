        "start_datetime": {
          "type": "MinMaxDatetime",
          "datetime": "{{ config.get('start_date', '2000-01-01T00:00:00Z') }}",
          "datetime_format": "%Y-%m-%dT%H:%M:%SZ"
        }
      }
    },
    {
      "type": "DeclarativeStream",
      "name": "users",
      "primary_key": [
        "id"
      ],
      "schema_loader": {
        "type": "InlineSchemaLoader",
        "schema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": {
              "type": "string"
            },
            "object": {
              "type": [
                "null",
                "string"
              ]
            },
            "type": {
              "type": [
                "null",
                "string"
              ]
            },
            "name": {
              "type": [
                "null",
                "string"
              ]
            },
            "avatar_url": {
              "type": [
                "null",
                "string"
              ]
            },
            "person": {
              "type": [
                "null",
                "object"
              ],
              "additionalProperties": true
            },
            "bot": {
              "type": [
                "null",
                "object"
              ],
              "additionalProperties": true
            }
          }
        }
      },
      "retriever": {
        "type": "SimpleRetriever",
        "requester": {
          "$ref": "#/definitions/credential_proxy_requester",
          "request_body": {
            "type": "RequestBodyJsonObject",
            "value": {
              "connected_account_id": "{{ config['connected_account_id'] }}",
              "user_id": "{{ config['user_id'] }}",
              "method": "GET",
              "endpoint": "https://api.notion.com/v1/users",
              "parameters": "{{ [{'name': 'Notion-Version', 'value': config.get('notion_version', '2026-03-11'), 'type': 'header'}] + [{'name': 'page_size', 'value': '100', 'type': 'query'}] + ([{'name': 'start_cursor', 'value': next_page_token.next_page_token, 'type': 'query'}] if next_page_token else []) }}"
            }
          },
          "error_handler": {
            "type": "CompositeErrorHandler",
            "error_handlers": [
              {
                "type": "DefaultErrorHandler",
                "max_retries": 10,
                "backoff_strategies": [
                  {
                    "type": "WaitTimeFromResponse",
                    "wait_time_in_seconds": "{{ ((response.get('headers') or {}).get('retry-after') or (response.get('headers') or {}).get('Retry-After') or ((response.get('data') or {}).get('additional_data') or {}).get('retry_after') or 0) | int + 1 }}",
                    "max_waiting_time_in_seconds": 600
                  },
                  {
                    "type": "ExponentialBackoffStrategy",
                    "factor": 5
                  }
                ],
                "response_filters": [
                  {
                    "type": "HttpResponseFilter",
                    "action": "RETRY",
                    "predicate": "{{ response.get('status') in [429, 529, 500, 502, 503, 504] and ((response.get('data') or {}).get('additional_data') or {}).get('rate_limit_reason') != 'public_api_request_blocked' }}",
                    "error_message": "Notion is rate limiting or unavailable; retrying."
                  },
                  {
                    "type": "HttpResponseFilter",
                    "action": "IGNORE",
                    "predicate": "{{ response.get('status') == 403 }}",
                    "error_message": "This Notion connection can't list members; skipped."
                  },
                  {
                    "type": "HttpResponseFilter",
                    "action": "FAIL",
                    "failure_type": "config_error",
                    "predicate": "{{ response.get('status') == 401 or (response.get('data') or {}).get('code') in ['unauthorized', 'restricted_resource'] and response.get('status') != 403 }}",
                    "error_message": "Notion rejected the connection. Reconnect Notion."
                  },
                  {
                    "type": "HttpResponseFilter",
                    "action": "FAIL",
                    "failure_type": "system_error",
                    "predicate": "{{ (response.get('status') or 0) >= 400 }}",
                    "error_message": "Notion returned an unexpected error through the credential proxy proxy."
                  }
                ]
              }
            ]
          }
        },
        "record_selector": {
          "type": "RecordSelector",
          "extractor": {
            "type": "DpathExtractor",
            "field_path": [
              "data",
              "results"
            ]
          }
        },
        "paginator": {
          "type": "DefaultPaginator",
          "pagination_strategy": {
            "type": "CursorPagination",
            "cursor_value": "{{ (response.get('data') or {}).get('next_cursor') }}",
            "stop_condition": "{{ not (response.get('data') or {}).get('has_more') or not (response.get('data') or {}).get('next_cursor') }}"
          }
        }
      }
    }
  ],
  "spec": {
    "type": "Spec",
    "connection_specification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "required": [
        "credential_proxy_api_key",
        "connected_account_id",
        "user_id",
        "start_date"
      ],
      "additionalProperties": true,
      "properties": {
        "credential_proxy_api_key": {
          "type": "string",
          "title": "credential proxy API key",
          "airbyte_secret": true,
          "order": 0
        },
        "connected_account_id": {
          "type": "string",
          "title": "credential proxy connected account ID",
          "order": 1
        },
        "user_id": {
          "type": "string",
          "title": "credential proxy user ID",
          "order": 2
        },
        "start_date": {
          "type": "string",
          "title": "Start date",
          "description": "Pages edited before this are skipped. Hosted OpenCrawl imports everything (2000-01-01).",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "order": 3
        },
        "credential_proxy_base_url": {
          "type": "string",
          "title": "credential proxy base URL",
          "default": "https://credential-proxy.invalid",
          "order": 4
        },
        "notion_version": {
          "type": "string",
          "title": "Notion-Version",
          "default": "2026-03-11",
          "order": 5
        },
        "markdown_version": {
          "type": "string",
          "title": "Markdown version",
          "default": "v2",
          "order": 6
        },
        "requests_per_minute": {
          "type": "integer",
          "title": "Requests per minute",
          "default": 170,
          "minimum": 1,
          "maximum": 600,
          "order": 7
        },
        "lookback": {
          "type": "string",
          "title": "Lookback",
          "default": "PT30M",
          "order": 8
        },
        "num_workers": {
          "type": "integer",
          "title": "Concurrent requests",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "order": 9
        }
      }
    }
  }
}
