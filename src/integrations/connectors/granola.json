                    "additionalProperties": true,
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "object": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "title": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "owner": {
                        "type": [
                          "null",
                          "object"
                        ],
                        "additionalProperties": true,
                        "properties": {
                          "name": {
                            "type": [
                              "null",
                              "string"
                            ]
                          },
                          "email": {
                            "type": [
                              "null",
                              "string"
                            ]
                          }
                        }
                      },
                      "created_at": {
                        "type": "string"
                      },
                      "updated_at": {
                        "type": "string"
                      },
                      "web_url": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "calendar_event": {
                        "type": [
                          "null",
                          "object"
                        ],
                        "additionalProperties": true
                      },
                      "attendees": {
                        "type": [
                          "null",
                          "array"
                        ],
                        "items": {
                          "type": [
                            "null",
                            "object"
                          ],
                          "additionalProperties": true,
                          "properties": {
                            "name": {
                              "type": [
                                "null",
                                "string"
                              ]
                            },
                            "email": {
                              "type": [
                                "null",
                                "string"
                              ]
                            }
                          }
                        }
                      },
                      "folder_membership": {
                        "type": [
                          "null",
                          "array"
                        ],
                        "items": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      "space_membership": {
                        "type": [
                          "null",
                          "array"
                        ],
                        "items": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      "attachments": {
                        "type": [
                          "null",
                          "array"
                        ],
                        "items": {
                          "type": "object",
                          "additionalProperties": true
                        }
                      },
                      "summary_text": {
                        "type": [
                          "null",
                          "string"
                        ]
                      },
                      "summary_markdown": {
                        "type": [
                          "null",
                          "string"
                        ]
                      }
                    }
                  }
                },
                "retriever": {
                  "type": "SimpleRetriever",
                  "requester": {
                    "$ref": "#/definitions/granola_requester",
                    "path": "/v1/notes/{{ stream_partition.note_id }}",
                    "error_handler": {
                      "type": "DefaultErrorHandler",
