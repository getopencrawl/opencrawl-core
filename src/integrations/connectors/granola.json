      },
      "transformations": [
        {
          "type": "AddFields",
          "fields": [
            {
              "type": "AddedFieldDefinition",
              "path": [
                "note_id"
              ],
              "value": "{{ stream_slice.note_id }}"
            },
            {
              "type": "AddedFieldDefinition",
              "path": [
                "note_updated_at"
              ],
              "value": "{{ stream_slice.extra_fields['updated_at'] }}"
            }
          ]
        }
      ],
      "incremental_sync": {
        "type": "DatetimeBasedCursor",
        "cursor_field": "note_updated_at",
        "datetime_format": "%Y-%m-%dT%H:%M:%SZ",
        "cursor_datetime_formats": [
          "%Y-%m-%dT%H:%M:%S.%fZ",
          "%Y-%m-%dT%H:%M:%SZ",
          "%Y-%m-%dT%H:%M:%S.%f%z",
          "%Y-%m-%dT%H:%M:%S%z"
        ],
        "global_substream_cursor": true,
        "start_datetime": {
          "type": "MinMaxDatetime",
          "datetime": "{{ config['start_date'] }}",
          "datetime_format": "%Y-%m-%dT%H:%M:%SZ"
        }
      }
    }
  ],
  "spec": {
    "type": "Spec",
    "connection_specification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Granola workspace",
      "type": "object",
      "required": [
        "api_key",
        "start_date"
      ],
      "additionalProperties": true,
      "properties": {
        "api_key": {
          "type": "string",
          "title": "Granola workspace API key",
          "airbyte_secret": true,
          "order": 0
        },
        "start_date": {
          "type": "string",
          "title": "Backfill start (UTC)",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "order": 1
        },
        "num_workers": {
          "type": "integer",
          "title": "Concurrent requests",
          "minimum": 1,
          "maximum": 4,
          "default": 2,
          "order": 2
        },
        "base_url": {
          "type": "string",
          "title": "Granola API base URL",
          "default": "https://public-api.granola.ai",
          "order": 3
        }
      }
    }
  }
}
