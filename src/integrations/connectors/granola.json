                },
                "transformations": [
                  {
                    "type": "RemoveFields",
                    "field_pointers": [
                      [
                        "private_notes_text"
                      ],
                      [
                        "private_notes_markdown"
                      ],
                      [
                        "transcript"
                      ]
                    ]
                  }
