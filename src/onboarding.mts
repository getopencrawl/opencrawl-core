import {captureSetupPrompt} from './sessions/cloud-setup.mjs';
import {escapeHtml as escape} from './frontend-html.mjs';
import {statusIcon, arrowIcon as arrow} from './frontend-icons.mjs';
import {renderOnboardingShell} from './onboarding-shell.mjs';
/** The primary instruction follows the next unmet requirement; receipts remain authoritative. */
const copyIcon='<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
const disclosureChevron='<svg class="signal-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
const commandText=(text: unknown)=>String(text).split('\n').map(line=>line.split(' ').map(token=>`<span class="command-token">${escape(token)}</span>`).join(' ')).join('\n');
const copyBar=(text: string,label: string,attributes='')=>`<button type="button" class="command-snippet" data-copy="${escape(text)}" aria-label="${escape(label)}" ${attributes}${text?'':' disabled'}><code>${commandText(text)}</code><span class="snippet-feedback" aria-hidden="true"><span class="snippet-icon">${copyIcon}</span><span class="snippet-done">Copied</span></span></button><p class="snippet-copy-help signal-instruction" hidden>Copy the selected text with your keyboard or selection menu.</p>`;
export function renderOnboarding({mcpUrl,setupPrompt,nextUrl='/onboarding/sources'}: {mcpUrl?: string; setupPrompt?: string; nextUrl?: string}={}) {
 const api=new URL(mcpUrl!).origin;
 const prompt=setupPrompt || captureSetupPrompt(api);
 const verify='Call the OpenCrawl MCP tool test_connection. Confirm that it returns connected: true. If OpenCrawl is not available, help me connect its remote MCP server and sign in, then retry test_connection.';
 const session='Tell me which project we are working in and briefly describe its purpose.';
 const mcp=`Connect OpenCrawl’s remote MCP server at ${mcpUrl||''}. Guide me through sign-in, then call the OpenCrawl MCP tool test_connection and confirm it returns connected: true. Do not paste credentials into chat.`;
 const deploymentArgs=api && api!=='https://app.getopencrawl.com'?' --api '+api:'';
 const collectionCommand='opencrawl collect install'+deploymentArgs;
 const historyCommand='opencrawl collect backfill'+deploymentArgs;
 const recordingSignal=`<li class="expandable-signal" data-signal="recording" data-pending><details class="signal-disclosure"><summary>${statusIcon}<span><span class="signal-heading"><span class="signal-label">Enable session recording</span>${disclosureChevron}</span><span class="signal-detail" hidden></span></span><span class="signal-status">Required</span></summary><div class="signal-command">${copyBar(collectionCommand,'Copy session recording command')}<p class="signal-instruction">Installs recording hooks and offers an optional history import.</p></div></details></li>`;
 const firstSessionSignal=`<li class="expandable-signal signal-subitem" data-signal="session" data-pending><details class="signal-disclosure"><summary>${statusIcon}<span class="signal-heading"><span class="signal-label">Waiting for first session recording</span>${disclosureChevron}</span><span class="signal-status">Waiting</span></summary><div class="signal-command"><p class="signal-instruction">Start a new chat to verify recording works.</p><p class="signal-instruction">Use the coding agent and environment you just connected. The setup chat may not be recorded.</p><p class="signal-instruction">If no recording arrives, ask your agent to check:</p>${copyBar('opencrawl collect status','Copy recording status command')}</div></details></li>`;
 const historyInstructions=`${copyBar(historyCommand,'Copy history import command')}<p class="signal-instruction">Choose Claude Code, Codex, both, or skip in your terminal.</p><p class="signal-instruction">Importing uploads messages, tool activity, and available attachments.</p>`;
 const historySignal=()=>`<li class="expandable-signal signal-subitem" data-signal="history" data-pending><details class="signal-disclosure"><summary>${statusIcon}<span><span class="signal-heading"><span class="signal-label">Import past sessions</span>${disclosureChevron}</span><span class="optional-label">Optional</span><span class="signal-detail" hidden></span></span><span class="signal-status">Optional</span></summary><div class="signal-command"><div data-history-instructions>${historyInstructions}</div><p class="signal-instruction" data-history-importing hidden>Your past sessions are being imported. You can continue setup.</p></div></details></li>`;
 const sessionSignals=()=>`${recordingSignal}${firstSessionSignal}${historySignal()}`;
 const steps=[
  {id:'connect',title:'Connect your primary coding agent',description:'Install the OpenCrawl CLI to start recording your coding agent sessions.',action:'Copy setup prompt',prompt},
  {id:'mcp',title:'Complete MCP sign-in',description:'Your CLI is signed in. Finish OpenCrawl’s MCP sign-in in your coding agent. Your agent will test the connection afterward.',action:'Copy MCP setup prompt',prompt:mcp},
  {id:'verify',title:'Ask your agent to test the connection',description:'MCP is connected, but we haven’t received a successful connection test. Paste this prompt into your agent to run it.',action:'Copy test prompt',prompt:verify},
  {id:'session',title:'Start a new coding session',description:'Open a new session in your coding agent, then paste this small task. We’ll continue when its recording arrives.',action:'Copy a small task',prompt:session},
 ];
 return renderOnboardingShell(`
 <section id="onboarding-loading" class="focus-loading" role="status"><span class="waiting-dot" aria-hidden="true"></span> Checking your connection…</section>
 <section data-screen="connect" aria-labelledby="connect-title" hidden>
 <h1 id="connect-title" tabindex="-1">Connect your primary coding agent</h1>
 <p class="focus-description">Install the OpenCrawl CLI to start recording your coding agent sessions.</p>
 <div class="focus-action" id="setup-action"><div class="prompt-actions"><button type="button" class="primary copy-prompt" data-step="connect" data-label="Copy setup prompt"><span>Copy setup prompt</span></button><button type="button" class="primary prompt-toggle" aria-label="Show setup prompt" aria-expanded="false" aria-controls="connect-preview"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button></div></div>
 <div class="prompt-preview" id="connect-preview" hidden><p>${escape(prompt)}</p></div>
 <ul class="signal-checklist" aria-label="Connection checklist" hidden><li data-signal="cli" class="expandable-signal"><details class="signal-disclosure"><summary>${statusIcon}<span class="signal-heading"><span class="signal-label">Waiting for CLI sign-in</span>${disclosureChevron}</span><span class="signal-status">Waiting</span></summary><div class="signal-command">${copyBar('npm i -g @getopencrawl/cli@next\nopencrawl login'+deploymentArgs,'Copy CLI setup commands')}<p class="signal-instruction">Open the URL printed in your terminal and approve sign-in in your browser.</p></div></details></li><li data-signal="mcp" class="expandable-signal"><details class="signal-disclosure"><summary>${statusIcon}<span class="signal-heading"><span class="signal-label">Waiting for MCP sign-in</span>${disclosureChevron}</span><span class="signal-status">Waiting</span></summary><div class="signal-command">${copyBar(mcpUrl||'','Copy MCP server URL')}<p class="signal-instruction">Add this server in your agent’s settings, then complete sign-in.</p></div></details></li><li class="signal-subitem" data-signal="mcpTest"><svg class="signal-mark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg><span class="signal-label">Waiting for agent to test connection</span><span class="signal-status">Waiting</span></li>${sessionSignals()}</ul>
 </section>
 ${steps.map(step=>`<textarea id="${step.id}-prompt" data-label="${escape(step.action)}" hidden readonly>${escape(step.prompt)}</textarea>`).join('')}

 <section id="connection-error" aria-labelledby="error-title" hidden><h1 id="error-title" tabindex="-1">Let’s reconnect</h1><p class="focus-description" id="error-description">We couldn’t check your progress. Try again to pick up where you left off.</p><div class="focus-action"><button class="primary" type="button" id="retry-status">Try again ${arrow}</button></div><p class="focus-reassurance">You don’t need to repeat your setup.</p></section>
 <section id="manual-copy" aria-labelledby="manual-title" hidden><h1 id="manual-title" tabindex="-1">Copy this prompt</h1><p class="focus-description">Automatic copying isn’t available. Copy the selected text, then paste it into your coding agent.</p><label class="sr-only" for="copy-fallback">Prompt to copy</label><textarea id="copy-fallback" readonly rows="6"></textarea><div class="focus-action"><button class="primary" type="button" id="manual-next">I’ve copied it ${arrow}</button></div></section>
 <p id="progress-announcement" class="sr-only" role="status" aria-live="polite"></p>
 `,{nextUrl});
}
