# Copy to .env (./up.sh does this and fills the secrets). Never commit .env.

# Bearer token for the session receiver. `opencrawl collect` uploads with it.
OPENCRAWL_SESSIONS_TOKEN=
# Bearer token for MCP and `opencrawl search`. At least 32 characters.
MCP_TOKEN=
# Credentials for the bundled S3 (SeaweedFS). Any values; they only guard this local store.
OPENCRAWL_S3_ACCESS_KEY_ID=
OPENCRAWL_S3_SECRET_ACCESS_KEY=
OPENCRAWL_DATABASE_PASSWORD=

# The single fixed identity everything is captured and searched as.
OPENCRAWL_TENANT_ID=self-hosted
OPENCRAWL_USER_ID=owner
OPENCRAWL_USER_NAME=Owner

# Host ports, bound to 127.0.0.1 only.
OPENCRAWL_SESSIONS_PORT=8093
OPENCRAWL_MCP_PORT=8094
