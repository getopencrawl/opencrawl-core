# One independently operated organization. ./install.sh fills this file; keep it private.
COMPOSE_PROJECT_NAME=opencrawl
# http://localhost:8092 for a trial on this machine, or https://YOUR-DOMAIN with COMPOSE_PROFILES=https.
OPENCRAWL_URL=
OPENCRAWL_DOMAIN=
COMPOSE_PROFILES=
# Generated by ./install.sh.
OPENCRAWL_ORGANIZATION_ID=
OPENCRAWL_AUTH_SECRET=
OPENCRAWL_SETUP_TOKEN=
OPENCRAWL_CONNECTOR_KEY=
OPENCRAWL_S3_ACCESS_KEY_ID=
OPENCRAWL_S3_SECRET_ACCESS_KEY=
OPENCRAWL_TEMPORAL_PASSWORD=
OPENCRAWL_DOCKER_GID=
# Optional own Slack app (requires HTTPS). Its OAuth redirect is OPENCRAWL_URL/oauth/connectors/slack/callback.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional own GitHub App bundle; see docs/self-host.md. Granola uses a workspace key entered in the UI.
GITHUB_APP=
# The app binds to loopback; Caddy (COMPOSE_PROFILES=https) serves the public domain.
OPENCRAWL_APP_BIND=127.0.0.1
OPENCRAWL_APP_PORT=8092
