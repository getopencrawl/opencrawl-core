# One independently operated organization. Keep this file private after filling it.
# ./up.sh generates the empty local secret fields below on first run, then stops for configuration.
COMPOSE_PROJECT_NAME=opencrawl
OPENCRAWL_URL=
WORKOS_AUTH_ORIGIN=
WORKOS_CLIENT_ID=
WORKOS_API_KEY=
WORKOS_ORGANIZATION_ID=
WORKOS_COOKIE_PASSWORD=
OPENCRAWL_CONNECTOR_KEY=
OPENCRAWL_S3_ACCESS_KEY_ID=
OPENCRAWL_S3_SECRET_ACCESS_KEY=
OPENCRAWL_TEMPORAL_PASSWORD=
# Existing operator-owned Airbyte workspace; OpenCrawl does not provision Airbyte.
AIRBYTE_URL=
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_ID=
# URL that Airbyte connector pods can reach for the bundled S3 endpoint (port 18333).
OPENCRAWL_AIRBYTE_S3_ENDPOINT=
# URL that Airbyte can reach for the scoped credential proxy; defaults to OPENCRAWL_URL.
OPENCRAWL_AIRBYTE_APP_URL=
# Optional own Slack app. Its OAuth redirect is OPENCRAWL_URL/oauth/connectors/slack/callback.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Optional own GitHub App bundle; see README. Granola uses a workspace key entered in the UI.
GITHUB_APP=
# Ports bind to loopback. Set the private host interface only if your Airbyte needs network access.
OPENCRAWL_APP_BIND=127.0.0.1
OPENCRAWL_APP_PORT=8092
OPENCRAWL_S3_BIND=127.0.0.1
OPENCRAWL_S3_PORT=18333
